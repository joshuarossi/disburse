# Public browser configuration. Copy to .env.local for development.
# Every VITE_ value is shipped to the browser. Never add service credentials here.
VITE_CONVEX_URL=
VITE_WALLETCONNECT_PROJECT_ID=

# Optional HTTP-action origin. Omit to derive it from VITE_CONVEX_URL.
# If using a *.convex.site origin, it must name the same deployment.
# VITE_CONVEX_SITE_URL=

# Set explicitly for each build. Enable managed fees after provider acceptance.
VITE_GELATO_RELAY_ENABLED=false
VITE_GELATO_DEFAULT_FEE_TOKEN=USDC
VITE_GELATO_DEFAULT_FEE_MODE=stablecoin_preferred

# Optional unbilled public RPC endpoints. Paid operator RPC plans are not part
# of the product's cost model. Never expose a secret in a VITE_ variable.
# VITE_RPC_URL_11155111=
# VITE_SEPOLIA_RPC_URL=
# VITE_ETHEREUM_RPC_URL=

# CONVEX_DEPLOYMENT is written by `bunx convex dev` during local setup.
# Configure CONVEX_DEPLOY_KEY in the hosting environment, never in a VITE_ variable.
# Account history uses Safe's free Builder plan with a hard quota. Set
# SAFE_TX_SERVICE_API_KEY and SAFE_TX_SERVICE_PLAN=builder in Convex only.
# Paid Safe plans, automatic upgrades and app-funded service fallbacks are not
# supported. See docs/EXTERNAL_SERVICE_COSTS.md for the complete inventory.
