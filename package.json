{
  "name": "disburse",
  "private": true,
  "version": "2.0.0-rc.1",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "dev:convex": "convex dev",
    "deploy": "convex deploy --cmd 'bun run build:release' --cmd-url-env-var-name VITE_CONVEX_URL --typecheck enable",
    "build": "bun run release:config && vite build",
    "build:check": "bun run typecheck && bun run build",
    "build:release": "bun run build:check",
    "release:config": "bun scripts/check-release-config.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:convex": "vitest --project convex",
    "test:frontend": "vitest --project frontend",
    "typecheck": "tsc -b && tsc -p convex/tsconfig.json",
    "check": "bun run typecheck && bun run lint && bun run test:run",
    "test:e2e": "playwright test",
    "dev:qa": "vite --mode qa --host 127.0.0.1 --port 5174",
    "qa:testnet": "bun scripts/testnet-qa.mjs",
    "qa:workspace": "bun scripts/qa-workspace.mjs",
    "qa:screenshots": "node scripts/qa-screenshots.mjs",
    "contracts:compile": "bun scripts/contracts/compile.mjs --write",
    "test:contracts": "bun scripts/contracts/test.mjs"
  },
  "dependencies": {
    "@gelatocloud/gasless": "0.0.12",
    "@noble/curves": "1.9.7",
    "@openzeppelin/contracts": "5.4.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@safe-global/protocol-kit": "^6.1.2",
    "@safe-global/safe-deployments": "1.37.50",
    "@safe-global/safe-modules-deployments": "3.0.9",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.31.7",
    "fast-xml-parser": "^5.11.1",
    "framer-motion": "^12.43.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.562.0",
    "pdfjs-dist": "6.3.289",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^7.18.3",
    "resend": "^6.26.0",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "convex-test": "^0.0.41",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "ganache": "7.9.2",
    "globals": "^15.15.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "solc": "0.8.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "axios": "^1.18.0",
    "ws": "^8.21.3"
  }
}
